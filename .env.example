# Backend Configuration
SECRET_KEY=changeme-generate-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./quiz.db

# For production with PostgreSQL:
# DATABASE_URL=postgresql://quiz_user:quiz_password@localhost:5432/quiz_db

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin Registration Whitelist
# Comma-separated list of email addresses allowed to register as admin.
# Only these emails can create an admin account. Once registered, duplicate
# registration for the same email is blocked.
# If empty or not set, ALL registrations are denied.
ADMIN_ALLOWED_EMAILS=your-admin@example.com

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
